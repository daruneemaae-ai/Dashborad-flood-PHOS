<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>PHOS Flood Relief Data Center</title>
  <style>
    :root{--ink:#102a43;--muted:#627d98;--line:#dbe7ef;--bg:#f4f8fb;--paper:#fff;--nav:#0f3057;--teal:#08a6a0;--sky:#2296f3;--orange:#ff9d36;--coral:#f46767;--purple:#7956e8;--green:#20b486;--shadow:0 14px 34px rgba(32,68,104,.12)}
    *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--ink);font-family:"Noto Sans Thai","Leelawadee UI",Tahoma,sans-serif;font-size:15px} button,input,select,textarea{font:inherit}.hidden{display:none!important}
    .login{position:fixed;inset:0;z-index:20;min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 10% 15%,#4edfd4 0 7%,transparent 28%),radial-gradient(circle at 90% 10%,#8acbff 0 6%,transparent 26%),linear-gradient(135deg,#0f3057,#176b87 55%,#08a6a0)}
    .login-card{width:min(430px,calc(100% - 32px));padding:34px;background:rgba(255,255,255,.96);border-radius:26px;box-shadow:0 24px 58px rgba(0,27,59,.35)}.brand{display:flex;gap:13px;align-items:center}.brand-mark{display:grid;place-items:center;width:52px;height:52px;border-radius:17px;background:linear-gradient(145deg,var(--teal),var(--sky));color:#fff;font-size:27px;box-shadow:0 9px 18px rgba(8,166,160,.28)}.brand h1{margin:0;font-size:20px}.brand p{margin:2px 0 0;color:var(--muted);font-size:12px}.login h2{margin:32px 0 5px;font-size:25px}.login .hint{margin:0 0 22px;color:var(--muted)}
    label{display:block;font-weight:700;font-size:13px;margin:0 0 6px}.field{margin:0 0 15px}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:11px;padding:11px 12px;background:#fff;outline:none;transition:.2s}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(8,166,160,.13)}.field textarea{min-height:84px;resize:vertical}.btn{border:0;border-radius:11px;padding:11px 16px;cursor:pointer;font-weight:800;transition:.2s}.btn:hover{transform:translateY(-1px)}.btn-main{color:#fff;background:linear-gradient(105deg,var(--teal),var(--sky));box-shadow:0 8px 18px rgba(8,142,207,.2)}.btn-soft{color:#066c76;background:#e4fbfa}.btn-danger{background:#ffebeb;color:#c84242}.btn-wide{width:100%;padding:13px}.error{margin-top:12px;color:#c43333;font-weight:700;font-size:13px}
    .app{min-height:100vh;display:grid;grid-template-columns:248px 1fr}.side{position:sticky;top:0;height:100vh;padding:20px 14px;background:var(--nav);color:#dff3ff}.side .brand{padding:8px 8px 24px}.side .brand p{color:#9abfd7}.side .brand h1{color:#fff}.side .brand-mark{width:43px;height:43px;border-radius:14px;font-size:22px}.nav{display:grid;gap:5px}.nav button{display:flex;gap:11px;align-items:center;width:100%;padding:12px;border:0;border-radius:11px;background:transparent;color:#b7d6e8;text-align:left;cursor:pointer;font-weight:700}.nav button:hover,.nav button.active{background:rgba(255,255,255,.13);color:#fff}.side-foot{position:absolute;bottom:18px;left:14px;right:14px;padding:13px;background:rgba(255,255,255,.08);border-radius:12px;font-size:12px;color:#b7d6e8}.main{padding:24px 28px 40px;max-width:1600px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:22px}.top h2{margin:0;font-size:26px}.top p{margin:5px 0 0;color:var(--muted)}.top-actions{display:flex;gap:9px;align-items:center}.stamp{font-size:12px;color:var(--muted);text-align:right}.alert{display:flex;align-items:flex-start;gap:11px;background:#fff5df;border:1px solid #ffe1a2;color:#825600;border-radius:13px;padding:12px 14px;margin:0 0 20px}.alert b{color:#694300}
    .cards{display:grid;grid-template-columns:repeat(4,minmax(165px,1fr));gap:15px;margin-bottom:20px}.card{overflow:hidden;position:relative;padding:18px;border-radius:17px;background:var(--paper);box-shadow:var(--shadow);border:1px solid rgba(255,255,255,.85)}.card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--teal)}.card.sky:before{background:var(--sky)}.card.orange:before{background:var(--orange)}.card.coral:before{background:var(--coral)}.card .label{color:var(--muted);font-weight:700;font-size:13px}.card .value{margin-top:9px;font-size:27px;font-weight:900;letter-spacing:-.7px}.card .note{margin-top:5px;color:var(--muted);font-size:11px}.grid{display:grid;grid-template-columns:1.2fr .8fr;gap:20px}.panel{background:var(--paper);border-radius:17px;box-shadow:var(--shadow);padding:19px}.panel h3{font-size:16px;margin:0}.panel-sub{margin:4px 0 16px;color:var(--muted);font-size:12px}.chart-list{display:grid;gap:13px}.bar-row{display:grid;grid-template-columns:minmax(95px,150px) 1fr auto;gap:9px;align-items:center;font-size:13px}.bar{height:10px;border-radius:20px;background:#eaf1f5;overflow:hidden}.bar i{display:block;height:100%;border-radius:20px;background:linear-gradient(90deg,var(--teal),var(--sky))}.bar-row:nth-child(2n) .bar i{background:linear-gradient(90deg,var(--orange),#ffc65e)}.bar-row b{font-size:12px}.timeline{display:grid;gap:12px}.timeline-row{display:grid;grid-template-columns:86px 1fr auto;align-items:center;gap:11px;font-size:12px}.timeline-row time{color:var(--muted)}.dotline{height:8px;background:#e9f2f6;border-radius:10px}.dotline i{display:block;height:100%;background:var(--purple);border-radius:10px}.table-wrap{overflow:auto}.data-table{width:100%;border-collapse:collapse;font-size:13px}.data-table th{color:var(--muted);font-size:11px;text-align:left;padding:0 9px 10px;white-space:nowrap}.data-table td{padding:11px 9px;border-top:1px solid #edf2f5;vertical-align:top}.tag{display:inline-block;padding:3px 8px;border-radius:99px;background:#eaf9f7;color:#087b72;font-size:11px;font-weight:800}.tag.warn{background:#fff2d8;color:#a56300}.tag.red{background:#ffebeb;color:#c53939}.empty{padding:22px;color:var(--muted);text-align:center}.view{display:none}.view.active{display:block}
    .form-shell{max-width:1100px}.form-intro{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:15px}.type-pills{display:flex;flex-wrap:wrap;gap:7px}.pill{border:1px solid var(--line);border-radius:99px;padding:7px 10px;background:#fff;color:var(--muted);font-size:12px;font-weight:800}.pill.active{background:var(--nav);color:#fff;border-color:var(--nav)}.form-card{padding:24px}.form-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 14px}.span-2{grid-column:span 2}.span-3{grid-column:1/-1}.form-footer{display:flex;justify-content:flex-end;gap:9px;margin-top:9px;padding-top:17px;border-top:1px solid #edf2f5}.required:after{content:" *";color:#e04848}.info-box{margin:15px 0;padding:14px 16px;border-radius:12px;background:#eaf8ff;color:#165876;font-size:13px}.data-source-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.source-box{border:1px solid var(--line);border-radius:13px;padding:15px;background:#fbfdff}.source-box .count{font-size:24px;font-weight:900;margin-top:5px}.quality{display:grid;gap:10px}.quality-item{padding:12px;border-radius:11px;background:#fff9eb;border:1px solid #ffe7b2}.quality-item b{display:block;font-size:13px}.quality-item span{display:block;color:#815f1d;font-size:12px;margin-top:3px}
    .toast{position:fixed;right:20px;bottom:20px;z-index:9;max-width:360px;padding:13px 16px;border-radius:12px;background:#143654;color:#fff;box-shadow:var(--shadow);transform:translateY(120px);opacity:0;transition:.25s}.toast.show{transform:none;opacity:1}.loading{opacity:.55;pointer-events:none}.mobile-menu{display:none}
    @media(max-width:1080px){.cards{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}.data-source-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.app{display:block}.side{display:none}.side.open{display:block;position:fixed;z-index:7;width:250px;box-shadow:12px 0 30px rgba(0,0,0,.25)}.mobile-menu{display:inline-block}.main{padding:16px}.top{align-items:flex-start}.top h2{font-size:21px}.stamp{display:none}.cards{grid-template-columns:1fr 1fr;gap:10px}.card{padding:14px}.card .value{font-size:21px}.form-grid{grid-template-columns:1fr}.span-2,.span-3{grid-column:auto}.top-actions .btn-soft{display:none}.form-intro{display:block}.type-pills{margin-top:10px}.bar-row{grid-template-columns:95px 1fr auto}.grid{gap:14px}.panel{padding:15px}}
  </style>
</head>
<body>
  <section id="loginView" class="login hidden">
    <form id="loginForm" class="login-card" autocomplete="off">
      <div class="brand"><div class="brand-mark">🌊</div><div><h1>PHOS Data Center</h1><p>Flood Relief Management</p></div></div>
      <h2>เข้าสู่ระบบเจ้าหน้าที่</h2><p class="hint">ติดตามการรับบริจาค การช่วยเหลือ และข้อมูลพื้นที่</p>
      <div class="field"><label for="username">ชื่อผู้ใช้</label><input id="username" required value="Phos" autocapitalize="none"></div>
      <div class="field"><label for="password">รหัสผ่าน</label><input id="password" type="password" required placeholder="ระบุรหัสผ่าน"></div>
      <button class="btn btn-main btn-wide" type="submit">เข้าสู่ระบบ</button><div id="loginError" class="error" aria-live="polite"></div>
    </form>
  </section>

  <section id="appView" class="app">
    <aside id="sidebar" class="side">
      <div class="brand"><div class="brand-mark">🌊</div><div><h1>PHOS</h1><p>Flood Relief Data Center</p></div></div>
      <nav class="nav">
        <button class="active" data-view="dashboard">⌂ ภาพรวม Dashboard</button>
        <button class="staff-only hidden" data-view="entry">✦ บันทึกข้อมูลใหม่</button>
        <button class="staff-only hidden" data-view="datacenter">▦ Data Center</button>
      </nav>
      <div id="publicFooter" class="side-foot">Dashboard สาธารณะ<br><button id="loginNavBtn" style="margin-top:5px;padding:0;border:0;background:none;color:#fff;text-decoration:underline;cursor:pointer;font:inherit">🔐 เข้าสู่ระบบเจ้าหน้าที่</button></div>
      <div id="staffFooter" class="side-foot hidden">ข้อมูลสำหรับเจ้าหน้าที่<br><span id="sideUser">Phos</span> · <button id="logoutBtn" style="padding:0;border:0;background:none;color:#fff;text-decoration:underline;cursor:pointer">ออกจากระบบ</button></div>
    </aside>
    <main class="main">
      <header class="top"><div><button id="mobileMenu" class="btn btn-soft mobile-menu">☰</button><h2 id="viewTitle">ภาพรวมผลการดำเนินงาน</h2><p id="viewSubtitle">สรุปยอดที่ดึงจาก Google Sheets แบบล่าสุด</p></div><div class="top-actions"><select id="yearFilter" class="btn btn-soft" aria-label="เลือกปี พ.ศ."><option value="">ทุกปี (พ.ศ.)</option></select><div id="updatedStamp" class="stamp"></div><button id="refreshBtn" class="btn btn-soft">↻ รีเฟรชข้อมูล</button></div></header>
      <div id="dashboard" class="view active">
        <div class="alert"><span>⚠️</span><div><b>ข้อควรทราบด้านความถูกต้อง</b><br><span id="caveatText">กำลังโหลดข้อมูล...</span></div></div>
        <div class="cards" id="metricCards"></div>
        <section class="panel" style="margin-bottom:20px"><h3>สรุปผลแยกรายปี (พ.ศ.)</h3><p class="panel-sub">ปีที่เป็นช่วง เช่น 2566–2567 คงตามชื่อชุดข้อมูลต้นทาง</p><div class="table-wrap"><table class="data-table"><thead><tr><th>ปี พ.ศ.</th><th>ยอดบริจาคเดิม</th><th>เงินบริจาคที่บันทึกใหม่</th><th>ยอดใช้จ่าย</th><th>เงินคงเหลือ</th><th>ชุดช่วยเหลือตามรายการ</th></tr></thead><tbody id="annualTable"></tbody></table></div></section>
        <div class="grid">
          <section class="panel"><h3>ชุดช่วยเหลือแยกตามจังหวัด</h3><p class="panel-sub">รวมเฉพาะแถวที่ระบุว่าใช้คำนวณรวม</p><div id="provinceChart" class="chart-list"></div></section>
          <section class="panel"><h3>รายการใช้จ่าย</h3><p class="panel-sub">ข้อมูลจาก EXPENSES และ EXPENSE_INPUT</p><div id="expenseChart" class="chart-list"></div></section>
          <section class="panel"><h3>ความต้องการเร่งด่วน</h3><p class="panel-sub">รายการที่สถานะยังไม่ปิด</p><div id="needList"></div></section>
        </div>
        <section class="panel" style="margin-top:20px"><h3>การช่วยเหลือล่าสุดตามข้อมูลต้นทาง</h3><p class="panel-sub">วันที่แสดงเป็น พ.ศ. และรายการแยกตามปีที่เลือก</p><div class="table-wrap"><table class="data-table"><thead><tr><th>วันที่</th><th>ปี พ.ศ.</th><th>จังหวัด</th><th>อำเภอ</th><th>ชุมชน/สถานที่</th><th>จำนวนชุด</th><th>ชุดข้อมูล</th></tr></thead><tbody id="aidTable"></tbody></table></div></section>
      </div>

      <div id="entry" class="view">
        <div class="form-shell">
          <div class="form-intro"><div><h3 style="margin:0">บันทึกข้อมูลเข้าสู่ Data Center</h3><p class="panel-sub">เลือกประเภทข้อมูล แล้วกรอกเฉพาะข้อมูลที่มีหลักฐานหรือได้รับการยืนยัน</p></div><div class="type-pills" id="typePills"></div></div>
          <form id="entryForm" class="panel form-card">
            <input type="hidden" id="recordType" value="DONATION">
            <div class="form-grid">
              <div class="field" data-types="DONATION INVENTORY AID NEED EXPENSE"><label class="required" for="date">วันที่</label><input id="date" name="date" type="date"></div>
              <div class="field" data-types="DONATION"><label for="time">เวลา</label><input id="time" name="time" type="time"></div>
              <div class="field" data-types="DONATION"><label for="donor">ผู้บริจาค</label><input id="donor" name="donor" placeholder="หรือระบุ ไม่ประสงค์ออกนาม"></div>
              <div class="field" data-types="DONATION"><label class="required" for="donationType">ประเภทการบริจาค</label><select id="donationType" name="donationType"><option value="">เลือกประเภท</option><option>เงินสด/โอนเงิน</option><option>อาหาร</option><option>น้ำดื่ม</option><option>เสื้อผ้า</option><option>ยา/เวชภัณฑ์</option><option>อุปกรณ์จำเป็น</option><option>อื่น ๆ</option></select></div>
              <div class="field" data-types="DONATION"><label for="cashAmount">จำนวนเงิน (บาท)</label><input id="cashAmount" name="cashAmount" type="number" min="0" step="0.01"></div>
              <div class="field" data-types="DONATION INVENTORY AID"><label for="unit">หน่วย</label><input id="unit" name="unit" placeholder="เช่น ชุด, แพ็ก, ถุง"></div>
              <div class="field" data-types="DONATION"><label for="quantity">จำนวนสิ่งของ</label><input id="quantity" name="quantity" type="number" min="0" step="0.01"></div>
              <div class="field" data-types="DONATION"><label for="estimatedValue">มูลค่าประเมิน (บาท)</label><input id="estimatedValue" name="estimatedValue" type="number" min="0" step="0.01"></div>
              <div class="field" data-types="DONATION"><label for="collectionPoint">จุดรับบริจาค</label><input id="collectionPoint" name="collectionPoint"></div>
              <div class="field" data-types="DONATION INVENTORY AID NEED EXPENSE"><label for="officer">ผู้รับผิดชอบ</label><input id="officer" name="officer"></div>

              <div class="field" data-types="INVENTORY"><label class="required" for="item">รายการสิ่งของ</label><input id="item" name="item"></div>
              <div class="field" data-types="INVENTORY"><label class="required" for="movement">ประเภทการเคลื่อนไหว</label><select id="movement" name="movement"><option value="">เลือก</option><option>รับเข้า</option><option>จ่ายออก</option><option>ปรับปรุงยอด</option></select></div>
              <div class="field" data-types="INVENTORY"><label for="received">รับเข้า</label><input id="received" name="received" type="number" min="0" step="0.01"></div>
              <div class="field" data-types="INVENTORY"><label for="issued">จ่ายออก</label><input id="issued" name="issued" type="number" min="0" step="0.01"></div>
              <div class="field" data-types="INVENTORY"><label for="balance">คงเหลือหลังบันทึก</label><input id="balance" name="balance" type="number" min="0" step="0.01"></div>
              <div class="field" data-types="INVENTORY"><label for="sourceDestination">แหล่งที่มา/ปลายทาง</label><input id="sourceDestination" name="sourceDestination"></div>
              <div class="field" data-types="INVENTORY"><label for="referenceNo">เลขอ้างอิง</label><input id="referenceNo" name="referenceNo"></div>
              <div class="field" data-types="INVENTORY"><label for="expiryDate">วันหมดอายุ</label><input id="expiryDate" name="expiryDate" type="date"></div>

              <div class="field" data-types="AID NEED AREA"><label class="required" for="province">จังหวัด</label><input id="province" name="province" placeholder="เช่น ปัตตานี"></div>
              <div class="field" data-types="AID NEED AREA"><label for="district">อำเภอ</label><input id="district" name="district"></div>
              <div class="field" data-types="AID NEED AREA"><label for="subdistrict">ตำบล</label><input id="subdistrict" name="subdistrict"></div>
              <div class="field" data-types="AID NEED AREA"><label class="required" for="community">ชุมชน/หมู่บ้าน</label><input id="community" name="community"></div>
              <div class="field" data-types="AID"><label for="householdId">รหัสครัวเรือน</label><input id="householdId" name="householdId" placeholder="ไม่ต้องระบุชื่อบุคคลใน Dashboard"></div>
              <div class="field" data-types="AID"><label for="households">จำนวนครัวเรือน</label><input id="households" name="households" type="number" min="0"></div>
              <div class="field" data-types="AID"><label for="people">จำนวนผู้รับ</label><input id="people" name="people" type="number" min="0"></div>
              <div class="field" data-types="AID"><label for="vulnerableGroup">กลุ่มเปราะบาง</label><input id="vulnerableGroup" name="vulnerableGroup" placeholder="เช่น ผู้สูงอายุ, ผู้พิการ"></div>
              <div class="field" data-types="AID"><label class="required" for="aidType">ประเภทความช่วยเหลือ</label><input id="aidType" name="aidType" placeholder="เช่น ชุดยังชีพ"></div>
              <div class="field" data-types="AID"><label for="quantityUnit">จำนวน/หน่วย</label><input id="quantityUnit" name="quantityUnit" placeholder="เช่น 20 ชุด"></div>

              <div class="field" data-types="NEED"><label class="required" for="need">ความต้องการ</label><input id="need" name="need" placeholder="เช่น น้ำดื่ม"></div>
              <div class="field" data-types="NEED"><label class="required" for="priority">ระดับความเร่งด่วน</label><select id="priority" name="priority"><option value="">เลือก</option><option>เร่งด่วนมาก</option><option>เร่งด่วน</option><option>ปกติ</option></select></div>
              <div class="field" data-types="NEED"><label for="waitingHouseholds">ครัวเรือนที่รอ</label><input id="waitingHouseholds" name="waitingHouseholds" type="number" min="0"></div>
              <div class="field" data-types="NEED"><label for="dueDate">กำหนดแล้วเสร็จ</label><input id="dueDate" name="dueDate" type="date"></div>

              <div class="field" data-types="EXPENSE"><label for="expenseCategory">หมวดค่าใช้จ่าย</label><input id="expenseCategory" name="expenseCategory" placeholder="เช่น เวชภัณฑ์"></div>
              <div class="field" data-types="EXPENSE"><label class="required" for="expenseItem">รายการค่าใช้จ่าย</label><input id="expenseItem" name="expenseItem"></div>
              <div class="field" data-types="EXPENSE"><label class="required" for="amount">จำนวนเงิน (บาท)</label><input id="amount" name="amount" type="number" min="0" step="0.01"></div>
              <div class="field" data-types="EXPENSE"><label for="documentNo">เลขเอกสาร/ใบเสร็จ</label><input id="documentNo" name="documentNo"></div>
              <div class="field" data-types="EXPENSE"><label for="approver">ผู้อนุมัติ</label><input id="approver" name="approver"></div>
              <div class="field" data-types="EXPENSE"><label for="verificationStatus">สถานะตรวจสอบ</label><select id="verificationStatus" name="verificationStatus"><option>รอตรวจสอบ</option><option>ตรวจสอบแล้ว</option><option>ไม่ผ่านการตรวจสอบ</option></select></div>

              <div class="field" data-types="AREA"><label for="affectedHouseholds">ครัวเรือนที่ได้รับผลกระทบ</label><input id="affectedHouseholds" name="affectedHouseholds" type="number" min="0"></div>
              <div class="field" data-types="AREA"><label for="affectedPeople">ประชาชนที่ได้รับผลกระทบ</label><input id="affectedPeople" name="affectedPeople" type="number" min="0"></div>
              <div class="field" data-types="AREA"><label for="vulnerableHouseholds">ครัวเรือนกลุ่มเปราะบาง</label><input id="vulnerableHouseholds" name="vulnerableHouseholds" type="number" min="0"></div>
              <div class="field" data-types="AREA"><label for="areaStatus">สถานะพื้นที่</label><select id="areaStatus" name="areaStatus"><option>รอประเมิน</option><option>กำลังช่วยเหลือ</option><option>ช่วยเหลือแล้วบางส่วน</option><option>ช่วยเหลือครบ</option></select></div>
              <div class="field" data-types="AREA"><label for="coordinator">ผู้ประสานงาน</label><input id="coordinator" name="coordinator"></div>

              <div class="field" data-types="DONATION AID EXPENSE"><label for="status">สถานะ</label><select id="status" name="status"><option>รับแล้ว</option><option>รอตรวจสอบ</option><option>ได้รับความช่วยเหลือ</option><option>รอดำเนินการ</option><option>ยกเลิก</option></select></div>
              <div class="field span-2" data-types="DONATION AID EXPENSE"><label for="evidenceUrl">ลิงก์หลักฐาน</label><input id="evidenceUrl" name="evidenceUrl" type="url" placeholder="https://..."></div>
              <div class="field span-3" data-types="DONATION INVENTORY AID NEED EXPENSE AREA"><label for="notes">หมายเหตุ</label><textarea id="notes" name="notes" placeholder="กรอกเฉพาะข้อเท็จจริงที่ตรวจสอบได้"></textarea></div>
            </div>
            <div class="info-box">ข้อมูลจะบันทึกลงชีตใหม่ตามประเภท (เช่น DONATIONS หรือ AID_CASES) และมีรหัสรายการอ้างอิงอัตโนมัติ</div>
            <div class="form-footer"><button id="clearForm" class="btn btn-soft" type="button">ล้างแบบฟอร์ม</button><button id="saveBtn" class="btn btn-main" type="submit">บันทึกข้อมูล</button></div>
          </form>
        </div>
      </div>

      <div id="datacenter" class="view">
        <section class="panel"><h3>สถานะชุดข้อมูล</h3><p class="panel-sub">นับจำนวนแถวข้อมูล ไม่รวมแถวหัวตาราง</p><div id="sourceGrid" class="data-source-grid"></div></section>
        <section class="panel" style="margin-top:20px"><h3>ประเด็นข้อมูลที่ต้องติดตาม</h3><p class="panel-sub">นำมาจากชีต DATA_GAPS ในไฟล์ต้นทาง</p><div id="qualityList" class="quality"></div></section>
      </div>
    </main>
  </section>
  <div id="toast" class="toast"></div>

  <script>
    /* URL ฝังตามที่กำหนด: เปลี่ยนได้เมื่อ Deploy GAS รุ่นใหม่ */
    const GAS_URL = 'https://script.google.com/macros/s/AKfycbw_OIpxeuC8lFJg-gc5gQgC9ZFxvv20oYPOyObTyTZI8tmEK-JDI1WjrhN5wGPHEwJx/exec';
    const TYPES = {DONATION:'เงิน/สิ่งของบริจาค',INVENTORY:'คลังสิ่งของ',AID:'การช่วยเหลือ',NEED:'ความต้องการเร่งด่วน',EXPENSE:'รายจ่าย',AREA:'ข้อมูลพื้นที่'};
    const app = {user:'',password:'',data:null,type:'DONATION',isStaff:false};
    const $ = id => document.getElementById(id);
    const money = n => n === null || n === undefined || n === '' ? '—' : new Intl.NumberFormat('th-TH',{style:'currency',currency:'THB',maximumFractionDigits:2}).format(Number(n));
    const number = n => new Intl.NumberFormat('th-TH').format(Number(n||0));
    const esc = s => String(s === undefined || s === null ? '' : s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));

    function jsonp(action, extra={}) { return new Promise((resolve,reject)=>{ const cb='__phosCb'+Date.now()+Math.floor(Math.random()*9999); const params=new URLSearchParams({action,user:app.user,password:app.password,callback:cb,...extra}); const script=document.createElement('script'); const deployHint='เชื่อมต่อไม่ได้: ให้ตรวจสอบว่า Apps Script มี doGet/doPost แล้ว Deploy เป็น Web App เวอร์ชันล่าสุด'; const timer=setTimeout(()=>finish(new Error(deployHint)),20000); function finish(err,data){clearTimeout(timer);delete window[cb];script.remove();err?reject(err):resolve(data)} window[cb]=data=>finish(null,data); script.onerror=()=>finish(new Error(deployHint)); script.src=GAS_URL+'?'+params.toString();document.head.appendChild(script); }); }
    function toast(msg){const el=$('toast');el.textContent=msg;el.classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>el.classList.remove('show'),3600)}
    function setLoading(on){document.body.classList.toggle('loading',on)}
    function barRows(list, formatter){if(!list.length)return '<div class="empty">ยังไม่มีข้อมูล</div>';const max=Math.max(...list.map(x=>Number(x.value)||0),1);return list.map(x=>`<div class="bar-row"><span>${esc(x.name)}</span><div class="bar"><i style="width:${Math.max(3,(Number(x.value)||0)/max*100)}%"></i></div><b>${formatter(x.value)}</b></div>`).join('')}
    function renderDashboard(data){app.data=data;renderYearFilter(data.annualSummary||[]);renderDashboardContent();$('updatedStamp').textContent='อัปเดต '+new Date().toLocaleString('th-TH')}
    function renderYearFilter(annual){const select=$('yearFilter');const previous=select.value;select.innerHTML='<option value="">ทุกปี (พ.ศ.)</option>'+annual.map(r=>`<option value="${esc(r.year)}">ปี ${esc(r.year)}</option>`).join('');select.value=annual.some(r=>r.year===previous)?previous:''}
    function renderAnnualTable(annual){$('annualTable').innerHTML=annual.length?annual.map(r=>`<tr><td><span class="tag">${esc(r.year)}</span></td><td>${r.donation===null?'—':money(r.donation)}</td><td>${money(r.newCashDonation)}</td><td>${r.expense===null?'—':money(r.expense)}</td><td>${r.remaining===null?'—':money(r.remaining)}</td><td>${number(r.aidSets)} ชุด</td></tr>`).join(''):'<tr><td colspan="6" class="empty">ยังไม่มีข้อมูลแยกรายปี</td></tr>'}
    function renderDashboardContent(){if(!app.data)return;const data=app.data;const selected=$('yearFilter').value;const annual=(data.annualSummary||[]).find(r=>r.year===selected);const m=annual?Object.assign({},data.metrics,{donationHistorical:annual.donation,newCashDonation:annual.newCashDonation,expenseTotal:annual.expense,remaining:annual.remaining,aidSets:annual.aidSets}):data.metrics;const yearNote=selected?'ปี พ.ศ. '+selected:'ทุกปี';const cards=[['ยอดบริจาค (ข้อมูลเดิม)',money(m.donationHistorical),yearNote,''],['เงินคงเหลือ',money(m.remaining),yearNote,'sky'],['ชุดช่วยเหลือจากรายการ',number(m.aidSets)+' ชุด',yearNote,'orange'],['ความต้องการที่ยังไม่ปิด',number(m.urgentNeeds)+' รายการ','ข้อมูลที่บันทึกใหม่','coral'],['ครัวเรือนที่บันทึกว่าช่วยเหลือ',m.receivedHouseholds?number(m.receivedHouseholds)+' ครัวเรือน':'—','AID_CASES',''],['เงินรับบริจาคที่บันทึกใหม่',money(m.newCashDonation),yearNote,'sky'],['ประเด็นข้อมูลต้องติดตาม',number(m.dataGaps)+' ประเด็น','DATA_GAPS','orange'],['รายการคลังสิ่งของ',number(m.inventoryRecords)+' รายการ','INVENTORY','coral']];$('metricCards').innerHTML=cards.map(c=>`<article class="card ${c[3]}"><div class="label">${c[0]}</div><div class="value">${c[1]}</div><div class="note">${c[2]}</div></article>`).join('');$('caveatText').textContent=data.caveat;renderAnnualTable(data.annualSummary||[]);$('provinceChart').innerHTML=barRows(selected?(data.provinceDistributionByYear[selected]||[]):data.provinceDistribution,number);$('expenseChart').innerHTML=barRows(selected?(data.expenseBreakdownByYear[selected]||[]):data.expenseBreakdown,money);renderNeeds(data.urgentNeeds);const aid=selected?data.recentAid.filter(r=>r.year===selected):data.recentAid;$('aidTable').innerHTML=aid.length?aid.map(r=>`<tr><td>${esc(r.date)}</td><td><span class="tag">${esc(r.year)}</span></td><td>${esc(r.province)}</td><td>${esc(r.district)}</td><td>${esc(r.community)}</td><td>${number(r.quantity)}</td><td><span class="tag">${esc(r.source)}</span></td></tr>`).join(''):'<tr><td colspan="7" class="empty">ยังไม่มีรายการในปีที่เลือก</td></tr>';renderDataCenter(data)}
    function renderNeeds(list){$('needList').innerHTML=list.length?`<div class="table-wrap"><table class="data-table"><thead><tr><th>พื้นที่</th><th>ความต้องการ</th><th>ระดับ</th></tr></thead><tbody>${list.map(r=>`<tr><td>${esc([r['ชุมชน/หมู่บ้าน'],r['ตำบล'],r['อำเภอ'],r['จังหวัด']].filter(Boolean).join(', '))}</td><td>${esc(r['ความต้องการ'])}</td><td><span class="tag ${r['ระดับความเร่งด่วน']==='เร่งด่วนมาก'?'red':r['ระดับความเร่งด่วน']==='เร่งด่วน'?'warn':''}">${esc(r['ระดับความเร่งด่วน'])}</span></td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">ยังไม่มีรายการความต้องการเร่งด่วนที่บันทึกใหม่</div>'}
    function renderDataCenter(data){if(!data.sourceCounts){$('sourceGrid').innerHTML='<div class="empty">กรุณาเข้าสู่ระบบเจ้าหน้าที่</div>';$('qualityList').innerHTML='';return}const labels={'KPI_SUMMARY':'ตัวชี้วัดเดิม','FIN_UPDATES':'อัปเดตการเงินเดิม','EXPENSES':'รายจ่ายเดิม','DIST_2568':'แจกจ่าย 2568','DIST_2567':'แจกจ่าย 2567','DIST_2566_67':'แจกจ่าย 2566–67','DONATIONS':'รับบริจาคใหม่','INVENTORY':'คลังสิ่งของ','AID_CASES':'ช่วยเหลือรายครัวเรือน','URGENT_NEEDS':'ความต้องการเร่งด่วน','EXPENSE_INPUT':'รายจ่ายใหม่'};$('sourceGrid').innerHTML=Object.entries(data.sourceCounts).map(([key,val])=>`<div class="source-box"><span>${labels[key]||key}</span><div class="count">${number(val)}</div><small>แถวข้อมูล</small></div>`).join('');$('qualityList').innerHTML=data.dataGaps.length?data.dataGaps.map(r=>`<div class="quality-item"><b>${esc(r['ประเด็นที่ไม่มี/ยังไม่ชัด'])}</b><span>${esc(r['เหตุผล'])}</span></div>`).join(''):'<div class="empty">ไม่พบประเด็นที่ต้องติดตาม</div>'}
    async function loadDashboard(){setLoading(true);try{const res=await jsonp('dashboard');if(!res.ok)throw new Error(res.message);app.isStaff=!!res.authenticated;renderDashboard(res.data)}catch(err){toast(err.message||'โหลดข้อมูลไม่สำเร็จ')}finally{setLoading(false)}}
    function renderPills(){ $('typePills').innerHTML=Object.entries(TYPES).map(([k,v])=>`<button type="button" class="pill ${k===app.type?'active':''}" data-type="${k}">${v}</button>`).join('');document.querySelectorAll('.pill').forEach(b=>b.addEventListener('click',()=>changeType(b.dataset.type)))}
    function changeType(type){app.type=type;$('recordType').value=type;document.querySelectorAll('[data-types]').forEach(el=>el.classList.toggle('hidden',!el.dataset.types.split(' ').includes(type)));document.querySelectorAll('.pill').forEach(b=>b.classList.toggle('active',b.dataset.type===type));$('entryForm').reset();$('recordType').value=type;const d=new Date();$('date').value=d.toISOString().slice(0,10)}
    function formPayload(){const fd=new FormData($('entryForm'));const p={type:app.type};fd.forEach((v,k)=>p[k]=String(v).trim());return p}
    async function saveRecord(e){e.preventDefault();const p=formPayload();setLoading(true);try{const res=await jsonp('save',{payload:JSON.stringify(p)});if(!res.ok)throw new Error(res.message);toast('บันทึกสำเร็จ: '+res.record.id);$('entryForm').reset();changeType(app.type);await loadDashboard()}catch(err){toast(err.message||'บันทึกไม่สำเร็จ')}finally{setLoading(false)}}
    function setStaffUi(isStaff){document.querySelectorAll('.staff-only').forEach(el=>el.classList.toggle('hidden',!isStaff));$('publicFooter').classList.toggle('hidden',isStaff);$('staffFooter').classList.toggle('hidden',!isStaff)}
    function openLogin(){ $('loginError').textContent='';$('loginView').classList.remove('hidden');setTimeout(()=>$('password').focus(),50) }
    function showView(name){if(name!=='dashboard'&&!app.isStaff){openLogin();return}document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active',v.id===name));document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===name));const meta={dashboard:['ภาพรวมผลการดำเนินงาน','สรุปยอดที่ดึงจาก Google Sheets แบบล่าสุด'],entry:['บันทึกข้อมูลใหม่','เพิ่มข้อมูลจริงเข้าสู่ศูนย์ข้อมูล'],datacenter:['Data Center','ตรวจสอบชุดข้อมูลและช่องว่างของข้อมูล']};$('viewTitle').textContent=meta[name][0];$('viewSubtitle').textContent=meta[name][1];$('sidebar').classList.remove('open')}
    $('loginForm').addEventListener('submit',async e=>{e.preventDefault();$('loginError').textContent='';app.user=$('username').value.trim();app.password=$('password').value;setLoading(true);try{const res=await jsonp('health');if(!res.ok)throw new Error(res.message);app.isStaff=true;setStaffUi(true);$('loginView').classList.add('hidden');$('sideUser').textContent=app.user;renderPills();changeType('DONATION');await loadDashboard()}catch(err){app.user='';app.password='';app.isStaff=false;$('loginError').textContent=err.message||'เข้าสู่ระบบไม่สำเร็จ'}finally{setLoading(false)}});
    document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view)));$('refreshBtn').addEventListener('click',loadDashboard);$('yearFilter').addEventListener('change',renderDashboardContent);$('entryForm').addEventListener('submit',saveRecord);$('clearForm').addEventListener('click',()=>changeType(app.type));$('loginNavBtn').addEventListener('click',openLogin);$('logoutBtn').addEventListener('click',async()=>{app.user='';app.password='';app.data=null;app.isStaff=false;$('password').value='';setStaffUi(false);showView('dashboard');await loadDashboard()});$('mobileMenu').addEventListener('click',()=>$('sidebar').classList.toggle('open'));setStaffUi(false);loadDashboard();
  </script>
</body>
</html>
